# Copy this file to .env and fill it in. Never commit .env.

# Optional. Free key from https://console.groq.com. Without it, commentary is
# written without AI.
GROQ_API_KEY=
# Optional. Defaults to openai/gpt-oss-120b.
GROQ_MODEL=

# Contact detail sent in the User-Agent to the Chess.com public API (an email
# address or a project URL). Chess.com asks API clients to identify themselves.
CHESSCOM_CONTACT=
